{
	"name": "responsify-dev",
	"version": "5.0.0",
	"type": "module",
	"author": {
		"name": "Petar Petrovic",
		"email": "petar@frontendlane.com",
		"url": "https://frontendlane.com/about/"
	},
	"homepage": "https://responsify.dev",
	"repository": "https://github.com/frontendlane/responsify/",
	"bugs": "https://github.com/frontendlane/responsify/issues",
	"license": "ISC",
	"keywords": [
		"responsive",
		"css",
		"scss",
		"calc",
		"@media"
	],
	"description": "Responsify: Prevent abrupt layout shifts when user resizes the browser",
	"scripts": {
		"postinstall": "./scripts/postinstall.sh",
		"update": "./scripts/update.sh",
		"dev": "npm run zip && ./scripts/dev.sh",
		"build": "npm run types && next build",
		"zip": "zip public/_responsify.scss.zip public/_responsify.scss",
		"test": "npx vitest",
		"types": "npx tsc",
		"start": "npx next start",
		"format": "npx prettier --write .",
		"lint": "npx next lint"
	},
	"dependencies": {
		"@hookform/resolvers": "4.1.3",
		"clipboard": "2.0.11",
		"next": "16.1.5",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hook-form": "7.56.3",
		"zod": "3.24.4"
	},
	"devDependencies": {
		"@shopify/eslint-plugin": "48.0.2",
		"@typescript-eslint/eslint-plugin": "8.32.0",
		"@typescript-eslint/parser": "8.32.0",
		"@testing-library/dom": "10.4.0",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "22.15.17",
		"@types/react": "19.1.3",
		"@types/react-dom": "19.1.4",
		"@vitejs/plugin-react": "4.4.1",
		"babel-plugin-react-compiler": "19.1.0-rc.1",
		"concurrently": "9.1.2",
		"eslint": "9.26.0",
		"eslint-plugin-jest-dom": "5.5.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-compiler": "19.1.0-rc.1",
		"eslint-plugin-react-hooks": "5.2.0",
		"eslint-plugin-regex": "1.10.0",
		"eslint-plugin-unused-imports": "4.1.4",
		"happy-css-modules": "4.0.0",
		"jsdom": "26.1.0",
		"npm-check-updates": "18.0.1",
		"prettier": "3.5.3",
		"typescript": "5.8.3",
		"vitest": "3.1.3"
	},
	"overrides": {
		"eslint": "9.26.0",
		"react": "19.1.0",
		"react-dom": "19.1.0"
	},
	"private": true
}
