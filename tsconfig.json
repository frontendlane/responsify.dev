{
	"compilerOptions": {
		"rootDirs": [
			".",
			"cmk-generated" // needed by @css-modules-kit/codegen https://github.com/mizdra/css-modules-kit/blob/main/docs/get-started.md#configure-tsconfigjson
		],

		// Base options
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force", // ensures every file is treated as a module and not as a global script
		"esModuleInterop": true, // supports importing CJS modules in ESM
		"resolveJsonModule": true,
		"allowArbitraryExtensions": true,
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"libReplacement": false, // performance optimization https://devblogs.microsoft.com/typescript/announcing-typescript-5-8/#the---libreplacement-flag
		"skipLibCheck": true, // skips type checking *.d.ts files (both in source code and in node_modules)
		"noEmit": true,
		"target": "ESNext", // would be unnecessary because noEmit === true but to support `1n` bigint syntax "target" has to be "ES2020" or newer

		// Strictness
		"allowJs": false,
		"noUnusedLocals": false, // eslint does this better
		"noUnusedParameters": false, // eslint does this better
		"strict": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"allowUnusedLabels": false,
		"allowUnreachableCode": false,
		"verbatimModuleSyntax": true, // enforces the use of `type` specifier in import statements, either `import type {` or `import { type` syntax. only applies to types, not to values used as types (`typeof someValue`)
		"erasableSyntaxOnly": true, // bans the use of typescript features that incur a runtime code change e.g. enums
		"noUncheckedIndexedAccess": true, // https://www.youtube.com/watch?v=JwZaP3pY7Zo
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedSideEffectImports": true,

		// Developer experience
		"allowSyntheticDefaultImports": true,
		"noErrorTruncation": true,
		"allowImportingTsExtensions": true, // valid only if noEmit === true

		// React and Next.js
		"jsx": "react-jsx",
		"plugins": [{ "name": "next" }],
		"incremental": true // would be unnecessary because noEmit === true but next.js needs it for some reason

		// "paths": {}, // don't use import aliases: https://paularmstrong.dev/blog/2023/08/29/import-path-aliasing-is-a-crutch-for-poor-architecture/
		// "baseUrl": "", // don't use "baseUrl" because it breaks vitest

		// "forceConsistentCasingInFileNames": true, // unnecessary because default value is true
		// "isolatedModules": true, // unnecessary because verbatimModuleSyntax === true
	},
	// css-modules-kit options
	"cmkOptions": {
		"enabled": true,
		"dtsOutDir": "cmk-generated",
		"arbitraryExtensions": true // ideally should not be necessary and instead `allowArbitraryExtensions` compiler flag should be respected
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.module.css" // needed by css-modules-kit IDE extension https://github.com/mizdra/css-modules-kit/blob/main/docs/get-started.md#configure-tsconfigjson
	],
	"exclude": ["node_modules"]
}
